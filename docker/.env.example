# Copy to docker/.env for local overrides
APP_NAME=Smart Money AI Scanner
APP_ENV=development
SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql+asyncpg://smas:smas@postgres:5432/smas
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://smas:smas@rabbitmq:5672/
BYBIT_BASE_URL=https://api.bybit.com
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear
BYBIT_CATEGORY=linear
SCAN_INTERVAL_SECONDS=30
SCAN_SYMBOL_LIMIT=50
DEFAULT_TIMEFRAMES=15,60,240,D
MIN_SIGNAL_SCORE=50
LLM_ENABLED=false
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=deepseek-chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_COOLDOWN_MINUTES=30
NOTIFY_MIN_SCORE=90
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
ENABLED_EXCHANGES=bybit,okx,bitget,mexc,bingx,kucoin
SMAS_API_URL=http://localhost:8000
