# SMAS VPS env — copy to docker/.env.vps on server (never commit real password)
APP_NAME=Smart Money AI Scanner
APP_ENV=production
SECRET_KEY=change-me-generate-on-server

SMAS_PG_USER=smas
SMAS_PG_PASSWORD=CHANGE_ME
SMAS_PG_DB=smas

DATABASE_URL=postgresql+asyncpg://smas:CHANGE_ME@postgres:5432/smas
REDIS_URL=redis://redis:6379/0

BYBIT_BASE_URL=https://api.bybit.com
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear
BYBIT_CATEGORY=linear

SCAN_INTERVAL_SECONDS=300
SCAN_SYMBOL_LIMIT=30
MIN_SIGNAL_SCORE=50
DEFAULT_TIMEFRAMES=15,60,240,D
ENABLED_EXCHANGES=bybit,okx,bitget,mexc,bingx,kucoin

LLM_ENABLED=false
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=deepseek-chat

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_COOLDOWN_MINUTES=30
NOTIFY_MIN_SCORE=90

CORS_ORIGINS=http://108.174.78.39:3010,http://localhost:3010,http://localhost:3001

NEXT_PUBLIC_API_URL=http://108.174.78.39:8010
NEXT_PUBLIC_WS_URL=ws://108.174.78.39:8010
SMAS_API_URL=http://108.174.78.39:8010
